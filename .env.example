# Copy to .env (gitignored) and fill in. Never commit .env.
# Sites
KSSL_LIVE_URL=https://<live host>
KSSL_REVIEW_URL=https://<review host>
KSSL_REVIEW_USER=<review login>
KSSL_REVIEW_PASSWORD=<review password>

# VPS (routines/tunnel.sh reads these); SSH key at ~/.ssh/kssl_vps
KSSL_VPS_HOST=<vps ip or hostname>
KSSL_VPS_SSH_USER=<ssh user>
# VPS Postgres through the tunnel (local port 55460)
KSSL_VPS_STAGING_DSN="host=127.0.0.1 port=55460 dbname=kssl_staging user=kssl_app password=<app password>"
KSSL_VPS_SERVING_DSN="host=127.0.0.1 port=55460 dbname=kssl_serving user=kssl_app password=<app password>"

# Local Docker Postgres (container kssl-pg)
KSSL_STAGING_DSN="host=127.0.0.1 port=55432 dbname=kssl_staging user=kssl password=kssl"
KSSL_SERVING_DSN="host=127.0.0.1 port=55432 dbname=kssl_serving user=kssl password=kssl"
