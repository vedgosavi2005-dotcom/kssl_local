# Parallax Analyst settings. Copy to .env and fill in a key. .env holds secrets: never commit it.

# Model provider: "openrouter" (Claude via OpenRouter) or "anthropic" (Claude API direct)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=            # when LLM_PROVIDER=anthropic

# Spend cap for an OpenRouter key, in USD above the key's usage when the service first started.
# Delete .local/spend-baseline.json to start a fresh budget. 0 = no cap.
AGENT_BUDGET_USD=20

# Models (Claude API ids; mapped to OpenRouter ids automatically)
# AGENT_MODEL=claude-sonnet-5-5          # orchestrator
# AGENT_DATA_MODEL=claude-sonnet-5-5     # SQL / data agent
# AGENT_UI_MODEL=claude-haiku-5-5        # view designer
# AGENT_GUARD_MODEL=claude-haiku-5-5     # scope guard
# AGENT_REVIEW=1                         # design reviewer on/off
# AGENT_VERIFY=1                         # answer verifier on/off

# On a server, the database login goes in deploy/.env (see deploy/README.md).
