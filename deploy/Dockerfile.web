# Both builds in one image; `vite preview` serves them and runs the /api/img + /api/pulse middleware
# from vite.config.js (live headlines, image proxy), proxying the rest of /api to KSSL_API_TARGET.
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src src
RUN npx vite build --outDir dist && npx vite build --mode review --outDir dist-review
