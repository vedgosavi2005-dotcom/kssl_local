# Both builds in one image; `vite preview` serves them and runs the /api/img + /api/pulse middleware
# from vite.config.js (live headlines, image proxy), proxying the rest of /api to KSSL_API_TARGET.
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src src
# static files vite copies into each build (the product-category pictures, public/img/category)
COPY public public
# sign-in page and Ask Parallax on the LIVE build only, when the server's deploy/.env sets them (compose build args);
# unset (e.g. AWS) = both off. The review build never gets them.
ARG VITE_LOGIN=
ARG VITE_ASK_PARALLAX=
RUN VITE_LOGIN=$VITE_LOGIN VITE_ASK_PARALLAX=$VITE_ASK_PARALLAX npx vite build --outDir dist && \
    VITE_LOGIN= VITE_ASK_PARALLAX= npx vite build --mode review --outDir dist-review
